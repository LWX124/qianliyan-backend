<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stylefeng.guns.modular.system.dao.BizBalanceSnapshotMapper">

    <resultMap id="BaseResultMap" type="com.stylefeng.guns.modular.system.model.BizBalanceSnapshot">
        <id column="id" property="id"/>
        <result column="balance" property="balance"/>
        <result column="bill_date" property="billDate"/>
        <result column="alert_threshold" property="alertThreshold"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectLatest" resultMap="BaseResultMap">
        SELECT * FROM biz_balance_snapshot ORDER BY id DESC LIMIT 1
    </select>

    <select id="selectByBillDate" resultMap="BaseResultMap">
        SELECT * FROM biz_balance_snapshot WHERE bill_date = #{billDate} LIMIT 1
    </select>

</mapper>
